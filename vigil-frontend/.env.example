# VIGIL Environment Configuration

# Backend REST API endpoint (when live analysis backend is deployed)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Real-time WebSocket connection for live acoustic telemetry and risk score streams
VITE_WS_ANALYSIS_URL=ws://localhost:8000/ws/telemetry

# WebRTC STUN/TURN servers for live peer-to-peer audio calls
VITE_WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302

# Default demo mode active on initial launch (true for rehearsals, false for live calls)
VITE_DEFAULT_DEMO_MODE=true
